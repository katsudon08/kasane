{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Turborepoが入力が変化していないとtypecheckを省略するキャッシュを持つため、incrementalを有効化しない
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023", "DOM"],
		"types": ["vite/client"],
		"jsx": "react-jsx"
	},
	"include": ["src", ".storybook/preview.tsx"]
}
