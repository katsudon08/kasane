	},
	"devDependencies": {
		"@storybook/react-vite": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"storybook": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:",
		"wait-on": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "error"
		}
	},
	"packageManager": "pnpm@12.9.1"
}
