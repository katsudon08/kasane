{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Turborepoが入力が変化していないとtypecheckを省略するキャッシュを持つため、incrementalを有効化しない
		"tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
		"target": "ES2023",
		"lib": ["ES2023"],
		"types": ["node"]
	},
	"include": ["vite.config.ts", "steiger.config.ts", ".storybook/main.ts"]
}
