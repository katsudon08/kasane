{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Turborepo が入力が変化していないと typecheck を省略するキャッシュを持つため、incremental を有効化しない
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx"
  },
  "include": ["src"]
}
