{
	"$schema": "https://turborepo.dev/schema.json",
	"agentGuidance": false,
	"globalDependencies": ["tsconfig.base.json"],
	"tasks": {
		// 依存先のパッケージのファイル変更を伝達するためだけの空のタスク
		"transit": { "dependsOn": ["^transit"] },
		"dev": {
			"persistent": true,
			"cache": false
		},
		"build": {
			// 依存先であるlib-client / uiにはbuildスクリプトがない
			// そのため、実際には何も実行されないが依存先のファイルの変更をトリガーにbuildタスクを再度実行する
			"dependsOn": ["^build"],
			// キャッシュがヒットした時に、dist/を復元する
			"outputs": ["dist/**"]
		},
		// 依存先パッケージの変更でキャッシュを無効化しつつ、依存先のタスク完了を待たずに並列実行する
		"typecheck": { "dependsOn": ["^transit"] },
		// ルート直下（Playwrightの設定・E2E・oxlintのプラグイン）の型チェック
		"//#typecheck": {},
		"test": { "dependsOn": ["^transit"] },
		"//#lint": {},
		"lint:fsd": {
			"cache": false
		},
		// ファイルがfix前の状態に戻ったら同じハッシュになり、キャッシュが効いてしまうためcache: falseに設定する
		"//#lint:fix": {
			"cache": false
		},
		"//#fmt": {},
		"//#fmt:fix": {
			"dependsOn": ["//#lint:fix"],
			"cache": false
		},
		"//#check": {
			"dependsOn": ["//#lint", "//#fmt"]
		},
		"//#check:fix": {
			"dependsOn": ["//#lint:fix", "//#fmt:fix"]
		},
		// E2Eは開発サーバーを起動して実行するため、キャッシュしない
		"//#e2e": {
			"cache": false
		},
		"storybook": {
			"persistent": true,
			"cache": false
		},
		"//#storybook": {
			"persistent": true,
			"cache": false
		}
	}
}
