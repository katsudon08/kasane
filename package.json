{
	"name": "kasane",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxlint --no-error-on-unmatched-pattern",
		"lint:fix": "oxlint --no-error-on-unmatched-pattern --fix",
		"fmt": "oxfmt --no-error-on-unmatched-pattern --check",
		"fmt:fix": "oxfmt --no-error-on-unmatched-pattern",
